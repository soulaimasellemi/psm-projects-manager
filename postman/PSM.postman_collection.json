{
  "info": {
    "name": "PSM - Projects Manager (SmartSoft)",
    "description": "Collection de test de l'API Spring Boot.\n\n1. Lancez d'abord 'Login ADMIN' puis 'Login COLLABORATEUR' : les tokens sont enregistrés automatiquement.\n2. Testez ensuite les dossiers Clients, Projets, Utilisateurs.\n3. Le dossier 'Tests de sécurité' vérifie les droits (401/403).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenCollab",
      "value": ""
    },
    {
      "key": "clientId",
      "value": "1"
    },
    {
      "key": "projetId",
      "value": "1"
    },
    {
      "key": "pendingUserId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (nouveau collaborateur)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@smartsoft.tn\",\n  \"password\": \"Test@123\",\n  \"tel\": \"+216 20 000 000\",\n  \"nom\": \"Test\",\n  \"prenom\": \"Utilisateur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Crée un compte INACTIF (rôle COLLABORATEUR) et envoie un email à l'admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Message de confirmation\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login compte non validé (403 attendu)",
